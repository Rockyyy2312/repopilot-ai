# Placeholder configuration for local development. Do not put credentials here.
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=5173
VITE_API_BASE_URL=/api/v1

# Auth/session settings. Replace the example secret outside local development.
REPOPILOT_ENV=development
REPOPILOT_SESSION_SECRET=replace-this-with-a-long-random-value
REPOPILOT_SECURE_COOKIES=false
REPOPILOT_DATA_DIR=./data
REPOPILOT_AUTH_DB=./data/repopilot-auth.sqlite3
REPOPILOT_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
